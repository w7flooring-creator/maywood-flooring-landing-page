---
/**
 * /resources/[slug] —— 资料详情页（resource 文档驱动；新增 issue #67 / #59）。
 *
 * Resources 列表卡的「View more」链向这里。getStaticPaths 枚举全部 resource slug，
 * build 时按 slug 拉详情（含 Portable Text 正文 + 解引用配图 / 相关产品 / FAQ）。
 *
 * 「内容尚未灌入是常态」（Phase 1，迁移后才有真实内容）：
 *  - 有 body → RichTextRenderer 渲染编辑正文；
 *  - body 为空 → 优雅回落：显示 excerpt（若有）+ 一个回 /contact 与 /resources 的 CTA，
 *    绝不留空白页、绝不 lorem / 占位卡。
 *
 * SEO：唯一 title / meta description（优先编辑填的 seo，否则回落 title / excerpt）；
 * canonical 自指（BaseLayout 取当前路径）。Breadcrumbs：Home > Resources > 标题
 * （含 BreadcrumbList JSON-LD）。语义 <main>（BaseLayout）/<article>/单 <h1>（hero）。
 * 纯静态（SSG），零 client JS。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import HeroImageSection from "@/components/HeroImageSection.astro";
import EditorialTextBlock from "@/components/EditorialTextBlock.astro";
import RichTextRenderer from "@/components/RichTextRenderer.astro";
import {
  getResourceBySlug,
  getResourceSlugs,
  hasResourceBody,
  buildResourceDownloadUrl,
  buildResourceBreadcrumbs,
  buildResourceSeo,
  type ResourceDetail,
} from "@/lib/content-pages";

export async function getStaticPaths() {
  const slugs = await getResourceSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };

// build 时按 slug 取资料（getStaticPaths 只产出存在的 slug，故正常应非空；
// 仍判 null 以防数据竞态，缺失则 404 —— 不渲染半成品页）。
const resource = (await getResourceBySlug(slug)) as ResourceDetail | null;
if (!resource) {
  return Astro.redirect("/404");
}

const FALLBACK_DESCRIPTION =
  "A Maywood Flooring resource — guidance and technical detail for timber, laminate and hybrid flooring. Contact our team for the full document.";

const breadcrumbs = buildResourceBreadcrumbs(resource);
const seo = buildResourceSeo({
  resource,
  fallbackDescription: FALLBACK_DESCRIPTION,
});

const showBody = hasResourceBody(resource);
---

<BaseLayout {...seo} motionProfile="editorial">
  <article class="resource">
    <div class="resource__crumbs">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    {
      /* Hero 渲染唯一 <h1>（资料标题）。category 作 eyebrow（无则不渲染）。
         heroImage 缺省时 HeroImageSection 自动降级为无图的克制标题。 */
    }
    <HeroImageSection
      title={resource.title}
      eyebrow={resource.category}
      image={resource.heroImage}
    />

    <EditorialTextBlock>
      {
        showBody ? (
          <RichTextRenderer value={resource.body} />
        ) : (
          /* 空 body 优雅回落：有 excerpt 则展示，否则用克制说明；绝不 lorem。 */
          <div class="resource__fallback">
            {resource.excerpt ? (
              <p class="resource__lead">{resource.excerpt}</p>
            ) : (
              <p class="resource__lead">
                The full version of this resource is being prepared. For the
                document, technical data or guidance you need, please get in
                touch and our team will help.
              </p>
            )}
          </div>
        )
      }

      {
        resource.downloads.length > 0 && (
          <section
            class="resource__downloads"
            aria-labelledby="resource-downloads-title"
          >
            <h2 id="resource-downloads-title" class="resource__downloads-title">
              Downloads
            </h2>
            <ul class="resource__downloads-list" role="list">
              {resource.downloads.map((download) => (
                <li>
                  <a
                    class="resource__download"
                    href={buildResourceDownloadUrl(download)}
                    aria-label={`Download ${download.title} PDF`}
                  >
                    <span class="resource__download-icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                        <path d="M14 2v6h6" />
                      </svg>
                      <span class="resource__download-format">PDF</span>
                    </span>
                    <span class="resource__download-title">
                      {download.title}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        !showBody && (
          <div class="resource__actions">
            <a class="resource__cta" href="/contact">
              Contact our team
            </a>
            <a class="resource__back" href="/resources">
              Back to all resources
            </a>
          </div>
        )
      }
    </EditorialTextBlock>

    {
      /* 相关产品（解引用 relatedProducts）—— Phase 1 product 未灌入时为空，区块隐藏。 */
      resource.relatedProducts.length > 0 && (
        <section
          class="resource__related"
          aria-labelledby="resource-related-title"
          data-motion-scene="grid"
        >
          <h2
            id="resource-related-title"
            class="resource__related-title"
            data-motion-layer="heading"
          >
            Related products
          </h2>
          <ul class="resource__related-list" role="list">
            {resource.relatedProducts.map((p) => (
              <li data-motion-layer="card">
                <a href={`/product-page/${p.slug}`}>{p.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .resource__crumbs {
    max-width: 80rem;
    margin-inline: auto;
    padding: 1.25rem clamp(1rem, 4vw, 2.5rem) 0;
  }

  /* 空 body 回落区：克制居中说明 + CTA（呼应列表页空状态 / 品牌 CTA token）。 */
  .resource__fallback {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }
  .resource__lead {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  .resource__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    margin-top: 1.75rem;
  }
  .resource__cta {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-cta);
    color: #fff;
    border-radius: var(--radius-cta);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .resource__cta:hover {
    opacity: 0.9;
  }
  .resource__back {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    font-size: 0.95rem;
  }

  .resource__downloads {
    max-width: 44rem;
    margin: 2.5rem auto 0;
    text-align: left;
  }
  .resource__downloads-title {
    margin: 0 0 1rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.15;
    color: var(--color-ink);
  }
  .resource__downloads-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .resource__download {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-cta);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .resource__download:hover {
    border-color: color-mix(in srgb, var(--color-ink) 45%, transparent);
    background: var(--color-bg-muted);
  }
  .resource__download:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
  .resource__download-icon {
    position: relative;
    display: grid;
    flex: 0 0 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    background: var(--color-bg-muted);
    border-radius: var(--radius-cta);
  }
  .resource__download-icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }
  .resource__download-format {
    position: absolute;
    inset-inline: 0;
    bottom: 0.35rem;
    font-size: 0.46rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .resource__download-title {
    font-size: 1rem;
    line-height: 1.35;
  }

  /* 相关产品交叉链接区。 */
  .resource__related {
    max-width: 44rem;
    margin-inline: auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem) var(--spacing-section);
  }
  .resource__related-title {
    margin: 0 0 1rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.15;
    color: var(--color-ink);
  }
  .resource__related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .resource__related-list a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
